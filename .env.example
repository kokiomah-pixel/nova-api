# Base URL for the Nova API
NOVA_API_URL=https://YOUR_API_DOMAIN

# Public discovery and x402 settlement are contained by default.
NOVA_PUBLIC_SERVICE_DISCOVERY_ENABLED=false
NOVA_PUBLIC_X402_ENABLED=false
NOVA_X402_SETTLEMENT_ENABLED=false

# Optional business payment destination for Legacy v1 billing metadata.
# Leave blank while payment collection is inactive.
NOVA_PAYMENT_DESTINATION=

# Optional x402 configuration. These values do not activate x402.
# Public x402 and settlement require their separate canonical feature flags.
X402_NETWORK=base
X402_ASSET=USDC
X402_SETTLEMENT_WALLET=
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Required only for CDP facilitator authentication when x402 settlement
# has been separately approved and enabled.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Required only by the manual live-payment test script.
# Never required by the Nova web-service runtime.
EVM_PRIVATE_KEY=

# Your assigned API key
NOVA_API_KEY=your_api_key_here

# Stripe billing webhook integration
STRIPE_SECRET_KEY=your_stripe_secret
STRIPE_WEBHOOK_SECRET=your_webhook_secret
STRIPE_PRICE_EMERGING_ID=price_emerging_id
STRIPE_PRICE_CORE_ID=price_core_id
STRIPE_PRICE_ENTERPRISE_ID=price_enterprise_id
