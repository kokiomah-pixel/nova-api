{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpe-nova-os.local/specs/architect_data_operations_policy.schema.json",
  "title": "Architect Data Operations Runtime Evidence Policy",
  "type": "object",
  "required": [
    "runtime_evidence_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "runtime_evidence_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "status",
        "activation",
        "pilot",
        "observation_window",
        "reporting",
        "approved_sources",
        "identifier_policy",
        "live_provenance_standard",
        "retention_policy",
        "notification_policy"
      ],
      "properties": {
        "policy_version": {
          "const": "1.0"
        },
        "status": {
          "const": "approved_for_bounded_pilot"
        },
        "activation": {
          "type": "object",
          "required": [
            "read_only",
            "manual_execution_only",
            "recurring_scheduler_enabled",
            "external_alert_delivery_enabled",
            "runtime_mutation_allowed"
          ],
          "properties": {
            "read_only": {
              "const": true
            },
            "manual_execution_only": {
              "const": true
            },
            "recurring_scheduler_enabled": {
              "const": false
            },
            "external_alert_delivery_enabled": {
              "const": false
            },
            "runtime_mutation_allowed": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "pilot": {
          "type": "object",
          "required": [
            "duration_days",
            "observation_window",
            "timezone",
            "generation_cadence",
            "production_health_claim_allowed"
          ],
          "properties": {
            "duration_days": {
              "const": 7
            },
            "observation_window": {
              "const": "rolling_24_hours"
            },
            "timezone": {
              "const": "UTC"
            },
            "generation_cadence": {
              "const": "once_daily_manual"
            },
            "production_health_claim_allowed": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "observation_window": {
          "type": "object",
          "required": [
            "type",
            "duration_hours",
            "timezone"
          ],
          "properties": {
            "type": {
              "const": "rolling"
            },
            "duration_hours": {
              "const": 24
            },
            "timezone": {
              "const": "UTC"
            }
          },
          "additionalProperties": false
        },
        "reporting": {
          "type": "object",
          "required": [
            "cadence",
            "scheduler_enabled",
            "automatic_delivery"
          ],
          "properties": {
            "cadence": {
              "const": "once_daily_manual"
            },
            "scheduler_enabled": {
              "const": false
            },
            "preferred_generation_period": {
              "type": "string"
            },
            "automatic_delivery": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "approved_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "source_kind",
              "ingestion_status",
              "authority_scope",
              "permitted_fields",
              "prohibited_fields"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "interface": {
                "type": "string"
              },
              "source_kind": {
                "enum": [
                  "runtime_record_source",
                  "runtime_interface"
                ]
              },
              "ingestion_status": {
                "enum": [
                  "approved_for_bounded_metadata",
                  "approved_when_structured_metadata_exists",
                  "approved_when_deterministic_validator_output_exists"
                ]
              },
              "activation_stage": {
                "type": "string"
              },
              "activation_enabled": {
                "type": "boolean"
              },
              "authority_scope": {
                "type": "object",
                "required": [
                  "authoritative_for",
                  "not_authoritative_for"
                ],
                "properties": {
                  "authoritative_for": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "not_authoritative_for": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "permitted_fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "prohibited_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "identifier_policy": {
          "type": "object"
        },
        "live_provenance_standard": {
          "type": "object",
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "retention_policy": {
          "type": "object",
          "required": [
            "raw_source_payload_copy",
            "ingestion",
            "generated_snapshot",
            "Architect_brief"
          ],
          "properties": {
            "raw_source_payload_copy": {
              "type": "object",
              "required": [
                "allowed"
              ],
              "properties": {
                "allowed": {
                  "const": false
                }
              },
              "additionalProperties": false
            },
            "ingestion": {
              "type": "object"
            },
            "generated_snapshot": {
              "type": "object"
            },
            "Architect_brief": {
              "type": "object"
            },
            "anomaly_metadata": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "unknown_field_policy": {
          "type": "object"
        },
        "repeat_threshold": {
          "type": "object"
        },
        "severity_mapping": {
          "type": "object"
        },
        "notification_policy": {
          "type": "object",
          "required": [
            "automatic_delivery",
            "recipients"
          ],
          "properties": {
            "automatic_delivery": {
              "const": false
            },
            "recipients": {
              "type": "object"
            },
            "immediate_surface_in_brief": {
              "type": "array"
            },
            "surface_when_material": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
