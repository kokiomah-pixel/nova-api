{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpe-nova-os.local/specs/retail_context_object_v0_1.schema.json",
  "title": "Retail Context Object v0.1",
  "description": "Authority-neutral context shared by retail context resources.",
  "type": "object",
  "required": [
    "resource_id",
    "resource_type",
    "subject",
    "schema_version",
    "generated_at",
    "context_status",
    "freshness",
    "confidence",
    "provenance",
    "evidence",
    "contradictions",
    "unresolved_evidence",
    "limitations",
    "authority_effect"
  ],
  "additionalProperties": false,
  "properties": {
    "resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "resource_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "subject": {"$ref": "#/$defs/subject"},
    "schema_version": {"const": "0.1.0"},
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "context_status": {
      "enum": [
        "resolved",
        "partially_resolved",
        "unresolved",
        "insufficient_evidence"
      ]
    },
    "freshness": {"$ref": "#/$defs/freshness"},
    "confidence": {"$ref": "#/$defs/confidence"},
    "provenance": {
      "type": "array",
      "items": {"$ref": "#/$defs/provenanceItem"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceItem"}
    },
    "contradictions": {
      "type": "array",
      "items": {"$ref": "#/$defs/contradiction"}
    },
    "unresolved_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolvedEvidence"}
    },
    "limitations": {
      "type": "array",
      "items": {"$ref": "#/$defs/limitation"}
    },
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "context_status": {"const": "insufficient_evidence"}
        },
        "required": ["context_status"]
      },
      "then": {
        "properties": {
          "unresolved_evidence": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["subject_id", "subject_type"],
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subject_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": [
        "observed_at",
        "source_age_seconds",
        "freshness_status"
      ],
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "source_age_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "freshness_status": {
          "enum": ["fresh", "aging", "stale", "unknown"]
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["level", "basis"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": ["high", "medium", "low", "indeterminate"]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "provenanceItem": {
      "type": "object",
      "required": [
        "source_id",
        "source_type",
        "observed_at",
        "source_status",
        "claim_reconciliation_status",
        "contribution_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "source_status": {
          "enum": [
            "present_unverified",
            "verified",
            "unavailable",
            "verification_failed"
          ]
        },
        "claim_reconciliation_status": {
          "enum": ["not_assessed", "reconciled", "unresolved", "contradicted"]
        },
        "contribution_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "evidence_id",
        "source_id",
        "claim_or_observation",
        "evidence_status"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "claim_or_observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence_status": {
          "enum": ["observed", "corroborated", "contradicted", "unresolved"]
        }
      }
    },
    "contradiction": {
      "type": "object",
      "required": [
        "contradiction_id",
        "evidence_ids",
        "summary",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "contradiction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "status": {
          "enum": ["unresolved", "partially_resolved", "resolved"]
        },
        "resolution_basis": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "unresolvedEvidence": {
      "type": "object",
      "required": ["issue_id", "status", "claim_scope", "reason"],
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": ["unresolved", "missing", "unavailable"]
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "related_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "limitation": {
      "type": "object",
      "required": ["limitation_id", "description", "impact"],
      "additionalProperties": false,
      "properties": {
        "limitation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "impact": {
          "enum": ["none_known", "limited_scope", "material", "indeterminate"]
        }
      }
    }
  }
}
