{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.example/specs/retail_production_control_v0_1.schema.json",
  "title": "Nova Retail Production Control Contract v0.1",
  "oneOf": [
    { "$ref": "#/$defs/service_admission" },
    { "$ref": "#/$defs/delivery_outcome" },
    { "$ref": "#/$defs/telemetry_event" },
    { "$ref": "#/$defs/incident" },
    { "$ref": "#/$defs/readiness_snapshot" }
  ],
  "$defs": {
    "nullable_resource_type": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "service_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "service_admission_id",
        "request_id",
        "resource_type",
        "subject_hash",
        "observed_at",
        "service_admission_status",
        "failure_reason",
        "rate_limit_count",
        "rate_limit_max_requests",
        "rate_limit_window_started_at_epoch",
        "authority_effect"
      ],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "record_type": { "const": "service_admission" },
        "service_admission_id": { "type": "string", "pattern": "^service-admission-[0-9a-f]{24}$" },
        "request_id": { "type": "string", "minLength": 1 },
        "resource_type": { "type": "string", "minLength": 1 },
        "subject_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observed_at": { "type": "string", "minLength": 1 },
        "service_admission_status": { "enum": ["admitted", "denied"] },
        "failure_reason": {
          "type": ["string", "null"],
          "enum": [null, "service_disabled", "rate_limit_exceeded", "unsupported_resource", "control_store_unavailable", "invalid_control_config"]
        },
        "rate_limit_count": { "type": ["integer", "null"], "minimum": 0 },
        "rate_limit_max_requests": { "type": ["integer", "null"], "minimum": 1 },
        "rate_limit_window_started_at_epoch": { "type": ["integer", "null"] },
        "authority_effect": { "const": "none" }
      },
      "allOf": [
        {
          "if": { "properties": { "service_admission_status": { "const": "admitted" } }, "required": ["service_admission_status"] },
          "then": {
            "properties": {
              "resource_type": { "enum": ["state_ping", "context_delta"] },
              "failure_reason": { "type": "null" },
              "rate_limit_count": { "type": "integer", "minimum": 1 },
              "rate_limit_max_requests": { "type": "integer", "minimum": 1 },
              "rate_limit_window_started_at_epoch": { "type": "integer" }
            }
          }
        }
      ]
    },
    "delivery_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "delivery_outcome_id",
        "claim_id",
        "request_id",
        "payment_receipt_id",
        "payment_requirement_id",
        "resource_type",
        "resource_uri",
        "delivery_eligibility_status",
        "delivery_status",
        "claimed_at",
        "failure_reason",
        "authority_effect"
      ],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "record_type": { "const": "delivery_outcome" },
        "delivery_outcome_id": { "type": "string", "pattern": "^delivery-outcome-[0-9a-f]{24}$" },
        "claim_id": { "type": ["string", "null"], "pattern": "^payment-claim-[0-9a-f]{24}$" },
        "request_id": { "type": "string", "minLength": 1 },
        "payment_receipt_id": { "type": ["string", "null"] },
        "payment_requirement_id": { "type": ["string", "null"] },
        "resource_type": { "$ref": "#/$defs/nullable_resource_type" },
        "resource_uri": { "type": ["string", "null"] },
        "delivery_eligibility_status": { "enum": ["eligible", "denied"] },
        "delivery_status": { "enum": ["pending", "denied"] },
        "claimed_at": { "type": "string", "minLength": 1 },
        "failure_reason": {
          "type": ["string", "null"],
          "enum": [null, "payment_already_consumed", "payment_replay_conflict", "control_store_unavailable", "service_disabled", "invalid_payment_outcome"]
        },
        "authority_effect": { "const": "none" }
      },
      "allOf": [
        {
          "if": { "properties": { "delivery_status": { "const": "pending" } }, "required": ["delivery_status"] },
          "then": {
            "properties": {
              "claim_id": { "type": "string", "pattern": "^payment-claim-[0-9a-f]{24}$" },
              "payment_receipt_id": { "type": "string", "minLength": 1 },
              "payment_requirement_id": { "type": "string", "minLength": 1 },
              "resource_type": { "enum": ["state_ping", "context_delta"] },
              "resource_uri": { "type": "string", "minLength": 1 },
              "delivery_eligibility_status": { "const": "eligible" },
              "failure_reason": { "type": "null" }
            }
          }
        }
      ]
    },
    "telemetry_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "event_id",
        "occurred_at",
        "event_type",
        "request_id",
        "resource_type",
        "subject_hash",
        "payment_receipt_id",
        "payment_requirement_id",
        "transaction_reference_hash",
        "duration_ms",
        "response_bytes",
        "failure_reason",
        "retail_namespace",
        "authority_effect"
      ],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "record_type": { "const": "telemetry_event" },
        "event_id": { "type": "string", "pattern": "^retail-event-[0-9a-f]{24}$" },
        "occurred_at": { "type": "string", "minLength": 1 },
        "event_type": { "enum": ["pre_payment_admitted", "pre_payment_denied", "rate_limit_denied", "payment_claimed", "payment_replay_denied", "delivery_completed", "delivery_failed", "service_disabled", "control_store_failure", "latency_observed"] },
        "request_id": { "type": "string", "minLength": 1 },
        "resource_type": { "$ref": "#/$defs/nullable_resource_type" },
        "subject_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "payment_receipt_id": { "type": ["string", "null"] },
        "payment_requirement_id": { "type": ["string", "null"] },
        "transaction_reference_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "response_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "failure_reason": { "type": ["string", "null"] },
        "retail_namespace": { "const": "retail_production_controls" },
        "authority_effect": { "const": "none" }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "incident_id", "occurred_at", "incident_type", "request_id", "resource_type", "payment_receipt_id", "failure_reason", "details", "retail_namespace", "authority_effect"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "record_type": { "const": "incident" },
        "incident_id": { "type": "string", "pattern": "^retail-incident-[0-9a-f]{24}$" },
        "occurred_at": { "type": "string", "minLength": 1 },
        "incident_type": { "enum": ["payment_replay_conflict", "control_store_unavailable", "delivery_failure", "rate_limit_pressure", "service_kill_switch_active"] },
        "request_id": { "type": ["string", "null"] },
        "resource_type": { "$ref": "#/$defs/nullable_resource_type" },
        "payment_receipt_id": { "type": ["string", "null"] },
        "failure_reason": { "type": "string", "minLength": 1 },
        "details": {
          "type": "object",
          "additionalProperties": { "type": ["string", "integer", "boolean", "null"] }
        },
        "retail_namespace": { "const": "retail_production_controls" },
        "authority_effect": { "const": "none" }
      }
    },
    "readiness_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "readiness_snapshot_id", "observed_at", "readiness_status", "checks", "failure_reasons", "authority_effect"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "record_type": { "const": "readiness_snapshot" },
        "readiness_snapshot_id": { "type": "string", "pattern": "^readiness-[0-9a-f]{24}$" },
        "observed_at": { "type": "string", "minLength": 1 },
        "readiness_status": { "enum": ["not_ready", "ready_for_controlled_proof"] },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["control_store_open", "schema_initialized", "operating_mode_controlled_proof", "rate_limit_configuration_valid", "payment_persistence_available", "telemetry_persistence_available"],
          "properties": {
            "control_store_open": { "type": "boolean" },
            "schema_initialized": { "type": "boolean" },
            "operating_mode_controlled_proof": { "type": "boolean" },
            "rate_limit_configuration_valid": { "type": "boolean" },
            "payment_persistence_available": { "type": "boolean" },
            "telemetry_persistence_available": { "type": "boolean" }
          }
        },
        "failure_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "authority_effect": { "const": "none" }
      }
    }
  }
}
