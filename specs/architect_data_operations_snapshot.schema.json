{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpe-nova-os.local/specs/architect_data_operations_snapshot.schema.json",
  "title": "Architect Data Operations Snapshot",
  "type": "object",
  "required": [
    "architect_data_operations_snapshot"
  ],
  "additionalProperties": false,
  "properties": {
    "architect_data_operations_snapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "observation_window",
        "environment",
        "data_mode",
        "runtime_observation",
        "runtime_evidence",
        "source_connection",
        "accepted_state_synchronization",
        "live_operating_health_established",
        "policy_status",
        "retention_metadata",
        "evidence_sources",
        "service_health",
        "intake_health",
        "context_health",
        "proof_health",
        "chronology_health",
        "boundary_health",
        "anomalies",
        "quiet_tracking",
        "Architect_action",
        "source_dependencies",
        "policy_dependencies",
        "candidate_source_surfaces_missing",
        "required_operating_sources_unconnected",
        "limitations",
        "snapshot_identity"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "observation_window": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ]
            },
            "end": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "environment": {
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "synthetic",
            "offline_fixture",
            "production_like",
            "live",
            "mixed",
            "unknown"
          ]
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        },
        "runtime_observation": {
          "$ref": "#/$defs/runtime_observation"
        },
        "runtime_evidence": {
          "$ref": "#/$defs/runtime_evidence"
        },
        "source_connection": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_connection"
          }
        },
        "accepted_state_synchronization": {
          "$ref": "#/$defs/accepted_state_synchronization"
        },
        "live_operating_health_established": {
          "type": "boolean",
          "const": false
        },
        "policy_status": {
          "enum": [
            "not_loaded",
            "loaded_and_validated"
          ]
        },
        "retention_metadata": {
          "type": "object"
        },
        "service_health": {
          "$ref": "#/$defs/health_layer"
        },
        "intake_health": {
          "$ref": "#/$defs/health_layer"
        },
        "context_health": {
          "$ref": "#/$defs/health_layer"
        },
        "proof_health": {
          "$ref": "#/$defs/health_layer"
        },
        "chronology_health": {
          "$ref": "#/$defs/health_layer"
        },
        "boundary_health": {
          "$ref": "#/$defs/health_layer"
        },
        "anomalies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anomaly"
          }
        },
        "quiet_tracking": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tracking_type",
              "evidence_state",
              "explanation"
            ],
            "properties": {
              "tracking_type": {
                "type": "string"
              },
              "source_anomaly_id": {
                "type": "string"
              },
              "evidence_state": {
                "$ref": "#/$defs/evidence_state"
              },
              "explanation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "Architect_action": {
          "type": "object",
          "required": [
            "required",
            "reasons"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "source_dependencies": {
          "type": "object",
          "required": [
            "missing_or_unconnected"
          ],
          "properties": {
            "missing_or_unconnected": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "policy_dependencies": {
          "type": "object",
          "required": [
            "unresolved"
          ],
          "properties": {
            "unresolved": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "candidate_source_surfaces_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_operating_sources_unconnected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot_identity": {
          "type": "object",
          "required": [
            "canonicalization_version",
            "canonical_hash",
            "input_record_count",
            "source_window"
          ],
          "properties": {
            "canonicalization_version": {
              "type": "string"
            },
            "canonical_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "input_record_count": {
              "type": "integer",
              "minimum": 0
            },
            "source_window": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "evidence_state": {
      "enum": [
        "observed_runtime",
        "repository_validated",
        "configured",
        "inferred",
        "unknown",
        "unavailable"
      ]
    },
    "evidence_value": {
      "type": "object",
      "required": [
        "value",
        "evidence_state"
      ],
      "properties": {
        "value": {},
        "evidence_state": {
          "$ref": "#/$defs/evidence_state"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "health_layer": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/evidence_value"
          },
          {
            "type": "object"
          },
          {
            "type": "array"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "properties": {
        "status": {
          "$ref": "#/$defs/evidence_value"
        }
      }
    },
    "source_kind": {
      "enum": [
        "runtime_record_source",
        "runtime_interface",
        "configured_source",
        "repository_contract",
        "fixture_source"
      ]
    },
    "availability_basis": {
      "enum": [
        "verified_path",
        "runtime_discovery",
        "configured",
        "repository_contract",
        "unavailable",
        "unknown"
      ]
    },
    "availability": {
      "type": "object",
      "required": [
        "available",
        "basis",
        "verified_at",
        "records_ingested",
        "record_count"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "basis": {
          "$ref": "#/$defs/availability_basis"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "records_ingested": {
          "type": "boolean"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "records_ingested": {
                "const": true
              }
            },
            "required": [
              "records_ingested"
            ]
          },
          "then": {
            "properties": {
              "record_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "evidence_source": {
      "type": "object",
      "required": [
        "name",
        "path_or_interface",
        "source_kind",
        "data_mode",
        "contains_sensitive_data",
        "retention_policy",
        "availability",
        "authoritative_for",
        "not_authoritative_for"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path_or_interface": {
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/source_kind"
        },
        "data_mode": {
          "type": "string"
        },
        "contains_sensitive_data": {
          "type": "boolean"
        },
        "retention_policy": {
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "authoritative_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_authoritative_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "runtime_observation": {
      "type": "object",
      "required": [
        "status",
        "evidence_state",
        "connected_sources",
        "discovered_sources",
        "records_ingested",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "no_sources_connected",
            "sources_discovered_no_records_ingested",
            "partial_records_ingested",
            "bounded_observation_complete",
            "unavailable",
            "unknown"
          ]
        },
        "evidence_state": {
          "$ref": "#/$defs/evidence_state"
        },
        "connected_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discovered_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "records_ingested": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "runtime_evidence": {
      "type": "object",
      "required": [
        "candidate_source_surfaces_discovered",
        "source_surfaces_verified",
        "runtime_records_ingested",
        "live_operating_health_established"
      ],
      "properties": {
        "candidate_source_surfaces_discovered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_surfaces_verified": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "available",
              "availability_basis",
              "records_ingested",
              "record_count"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "available": {
                "type": "boolean"
              },
              "availability_basis": {
                "$ref": "#/$defs/availability_basis"
              },
              "records_ingested": {
                "type": "boolean"
              },
              "record_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "runtime_records_ingested": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "live_operating_health_established": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "source_connection": {
      "type": "object",
      "required": [
        "source_id",
        "discovered",
        "policy_authorized",
        "connected",
        "records_ingested",
        "record_count",
        "availability_basis",
        "last_observed_at",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "discovered": {
          "type": "boolean"
        },
        "policy_authorized": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        },
        "records_ingested": {
          "type": "boolean"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "availability_basis": {
          "$ref": "#/$defs/availability_basis"
        },
        "last_observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "accepted_state_synchronization": {
      "type": "object",
      "required": [
        "operating_state",
        "evidence_coverage",
        "contradiction_detected",
        "action_state",
        "repository",
        "accepted_state_registry",
        "registry_source_resolution",
        "repository_state",
        "registry_operating_model",
        "registry_state",
        "Registry_ingestion",
        "registry_usage",
        "Accepted_state_delta",
        "chronology",
        "durable_archive",
        "runtime_evidence"
      ],
      "properties": {
        "operating_state": {
          "enum": [
            "bounded_infrastructure_accepted",
            "source_incomplete"
          ]
        },
        "evidence_coverage": {
          "enum": [
            "source_incomplete"
          ]
        },
        "contradiction_detected": {
          "type": "boolean",
          "const": false
        },
        "action_state": {
          "$ref": "#/$defs/action_state"
        },
        "repository": {
          "type": "object",
          "required": [
            "current_repo_movement_reviewed",
            "current_repo_movement_accepted",
            "accepted_remote_head",
            "rationale"
          ],
          "properties": {
            "current_repo_movement_reviewed": {
              "type": "boolean"
            },
            "current_repo_movement_accepted": {
              "type": "boolean"
            },
            "accepted_remote_head": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "rationale": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "accepted_state_registry": {
          "type": "object",
          "required": [
            "path",
            "updated",
            "accepted_entry_id",
            "schema_valid",
            "duplicate_entry_created"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "updated": {
              "type": "boolean"
            },
            "accepted_entry_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "schema_valid": {
              "type": "boolean"
            },
            "duplicate_entry_created": {
              "type": "boolean",
              "const": false
            }
          },
          "additionalProperties": false
        },
        "registry_source_resolution": {
          "type": "object",
          "required": [
            "local_runtime_root",
            "local_registry_absolute_path",
            "remote_repository",
            "remote_registry_commit",
            "canonical_registry_standard",
            "configured_registry_source",
            "source_selection_logic"
          ],
          "properties": {
            "local_runtime_root": {
              "type": "string"
            },
            "local_registry_absolute_path": {
              "type": "string"
            },
            "remote_repository": {
              "const": "kokiomah-pixel/sharpe-nova-os"
            },
            "remote_registry_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "canonical_registry_standard": {
              "type": "string"
            },
            "configured_registry_source": {
              "type": "string"
            },
            "source_selection_logic": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "repository_state": {
          "type": "object",
          "required": [
            "checkout_commit",
            "canonical_main_commit",
            "checkout_is_canonical_main",
            "canonical_main_verified"
          ],
          "properties": {
            "checkout_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "canonical_main_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "checkout_is_canonical_main": {
              "type": "boolean"
            },
            "canonical_main_verified": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "registry_operating_model": {
          "type": "object",
          "required": [
            "canonical_source",
            "local_mirror_required",
            "read_mode",
            "fallback_behavior",
            "local_mirror_authoritative"
          ],
          "properties": {
            "canonical_source": {
              "const": "repository_main"
            },
            "local_mirror_required": {
              "type": "boolean"
            },
            "read_mode": {
              "const": "read_only"
            },
            "fallback_behavior": {
              "const": "source_unavailable"
            },
            "local_mirror_authoritative": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "registry_state": {
          "type": "object",
          "required": [
            "canonical_source_state",
            "canonical_source_available",
            "canonical_commit",
            "canonical_registry_path",
            "selected_registry_path",
            "local_mirror_present",
            "local_mirror_commit",
            "local_mirror_in_sync",
            "mirror_lag_detected",
            "registry_schema_valid",
            "registry_entry_count"
          ],
          "properties": {
            "canonical_source_state": {
              "enum": [
                "verified_repository_main",
                "unverified_repository_checkout",
                "non_authoritative_local_mirror",
                "source_unavailable"
              ]
            },
            "canonical_source_available": {
              "type": "boolean"
            },
            "canonical_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "canonical_registry_path": {
              "type": "string"
            },
            "selected_registry_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "local_mirror_present": {
              "type": "boolean"
            },
            "local_mirror_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "local_mirror_in_sync": {
              "type": "boolean"
            },
            "mirror_lag_detected": {
              "type": "boolean"
            },
            "registry_schema_valid": {
              "type": "boolean"
            },
            "registry_entry_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "Registry_ingestion": {
          "type": "object",
          "required": [
            "canonical_source_state",
            "checkout_commit",
            "canonical_main_commit",
            "checkout_is_canonical_main",
            "canonical_main_verified",
            "canonical_registry_loaded",
            "canonical_source",
            "canonical_commit",
            "schema_valid",
            "registry_schema_valid",
            "current_accepted_state_claim_allowed",
            "mirror_status",
            "checkpoint_status",
            "contradictions_detected"
          ],
          "properties": {
            "canonical_source_state": {
              "enum": [
                "verified_repository_main",
                "unverified_repository_checkout",
                "non_authoritative_local_mirror",
                "source_unavailable"
              ]
            },
            "checkout_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "canonical_main_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "checkout_is_canonical_main": {
              "type": "boolean"
            },
            "canonical_main_verified": {
              "type": "boolean"
            },
            "canonical_registry_loaded": {
              "type": "boolean"
            },
            "canonical_source": {
              "const": "repository_main"
            },
            "canonical_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "schema_valid": {
              "type": "boolean"
            },
            "registry_schema_valid": {
              "type": "boolean"
            },
            "current_accepted_state_claim_allowed": {
              "type": "boolean"
            },
            "mirror_status": {
              "enum": [
                "not_required",
                "in_sync",
                "lag_detected"
              ]
            },
            "checkpoint_status": {
              "enum": [
                "available",
                "missing"
              ]
            },
            "contradictions_detected": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "registry_usage": {
          "type": "object",
          "required": [
            "allowed",
            "current_accepted_state_claim_allowed"
          ],
          "properties": {
            "allowed": {
              "enum": [
                "current_accepted_state",
                "bounded_checkout_context",
                "bounded_historical_context_only",
                "source_unavailable"
              ]
            },
            "current_accepted_state_claim_allowed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "Accepted_state_delta": {
          "type": "object",
          "required": [
            "newly_accepted",
            "stable_accepted_state",
            "checkpoint_path"
          ],
          "properties": {
            "newly_accepted": {
              "anyOf": [
                {
                  "const": "none"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "stable_accepted_state": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "checkpoint_path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "chronology": {
          "type": "object",
          "required": [
            "store",
            "canonical_event_required",
            "canonical_event_status",
            "event_id"
          ],
          "properties": {
            "store": {
              "type": "string"
            },
            "canonical_event_required": {
              "type": "boolean"
            },
            "canonical_event_status": {
              "enum": [
                "written",
                "pending"
              ]
            },
            "event_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "durable_archive": {
          "type": "object",
          "required": [
            "record_path",
            "status",
            "archive_reference",
            "verified"
          ],
          "properties": {
            "record_path": {
              "type": "string"
            },
            "status": {
              "enum": [
                "completed_and_verified",
                "written_receipt_pending",
                "pending_external_write",
                "destination_unavailable",
                "standard_unresolved"
              ]
            },
            "archive_reference": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "runtime_evidence": {
          "type": "object",
          "required": [
            "Stage_A_policy_and_ingestion_path",
            "Stage_A_live_operation",
            "Stage_B",
            "production_health_claim"
          ],
          "properties": {
            "Stage_A_policy_and_ingestion_path": {
              "const": "validated"
            },
            "Stage_A_live_operation": {
              "const": "not_established"
            },
            "Stage_B": {
              "const": "locked"
            },
            "production_health_claim": {
              "const": "prohibited"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "action_state": {
      "type": "object",
      "required": [
        "system_maintenance_action_required",
        "Architect_decision_required",
        "external_dependency_action_required",
        "assigned_to",
        "action_type",
        "blocking_state",
        "rationale"
      ],
      "properties": {
        "system_maintenance_action_required": {
          "type": "boolean"
        },
        "Architect_decision_required": {
          "type": "boolean"
        },
        "external_dependency_action_required": {
          "type": "boolean"
        },
        "assigned_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_type": {
          "enum": [
            "none",
            "registry_synchronization",
            "chronology_write",
            "archive_write",
            "repo_review",
            "source_acquisition",
            "Architect_policy_decision",
            "contradiction_resolution",
            "external_validation"
          ]
        },
        "blocking_state": {
          "enum": [
            "non_blocking",
            "blocks_state_acceptance",
            "blocks_Architect_decision",
            "blocks_external_claim",
            "blocks_production_claim"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "anomaly": {
      "type": "object",
      "required": [
        "anomaly_id",
        "anomaly_type",
        "first_observed",
        "last_observed",
        "occurrence_count",
        "affected_record_ids",
        "severity",
        "evidence_state",
        "explanation",
        "Architect_notification"
      ],
      "properties": {
        "anomaly_id": {
          "type": "string"
        },
        "anomaly_type": {
          "enum": [
            "source_provenance_missing",
            "source_class_conflict",
            "stale_source",
            "unexplained_classification_drift",
            "governance_epoch_mismatch",
            "proof_verification_failure",
            "replay_failure",
            "canonical_signature_mismatch",
            "chronology_link_failure",
            "authority_effect_invalid",
            "execution_boundary_violation",
            "evidence_source_unavailable",
            "unexpected_source_field"
          ]
        },
        "first_observed": {
          "type": "string"
        },
        "last_observed": {
          "type": "string"
        },
        "occurrence_count": {
          "type": "integer",
          "minimum": 1
        },
        "affected_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "enum": [
            "informational",
            "watch",
            "material",
            "critical"
          ]
        },
        "evidence_state": {
          "$ref": "#/$defs/evidence_state"
        },
        "explanation": {
          "type": "string"
        },
        "Architect_notification": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
