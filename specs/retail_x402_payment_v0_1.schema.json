{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.example/specs/retail_x402_payment_v0_1.schema.json",
  "title": "Nova Retail x402 Payment Contract v0.1",
  "oneOf": [
    { "$ref": "#/$defs/payment_requirement" },
    { "$ref": "#/$defs/payment_challenge" },
    { "$ref": "#/$defs/payment_receipt" }
  ],
  "$defs": {
    "nova_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paymentRequirementId",
        "resourceType",
        "resourceUri",
        "pricingModel",
        "authorityEffect",
        "accessEffect"
      ],
      "properties": {
        "paymentRequirementId": { "type": "string", "pattern": "^payment-requirement-[0-9a-f]{24}$" },
        "resourceType": { "enum": ["state_ping", "context_delta"] },
        "resourceUri": { "type": "string", "minLength": 1 },
        "pricingModel": { "const": "pay_per_context_resource" },
        "authorityEffect": { "const": "none" },
        "accessEffect": { "const": "context_resource_access_only" }
      }
    },
    "upstream_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "network", "asset", "amount", "payTo", "maxTimeoutSeconds", "extra"],
      "properties": {
        "scheme": { "const": "exact" },
        "network": { "const": "eip155:8453" },
        "asset": { "const": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" },
        "amount": { "enum": ["2000", "20000"] },
        "payTo": { "type": "string", "minLength": 1 },
        "maxTimeoutSeconds": { "const": 60 },
        "extra": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nova"],
          "properties": { "nova": { "$ref": "#/$defs/nova_extension" } }
        }
      }
    },
    "payment_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "payment_requirement_id",
        "x402_version",
        "scheme",
        "network",
        "display_network",
        "asset",
        "display_asset",
        "asset_decimals",
        "amount_atomic",
        "display_price_usdc",
        "settlement_wallet",
        "max_timeout_seconds",
        "resource_type",
        "resource_uri",
        "pricing_model",
        "authority_effect",
        "access_effect"
      ],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "record_type": { "const": "payment_requirement" },
        "payment_requirement_id": { "type": "string", "pattern": "^payment-requirement-[0-9a-f]{24}$" },
        "x402_version": { "const": 2 },
        "scheme": { "const": "exact" },
        "network": { "const": "eip155:8453" },
        "display_network": { "const": "base" },
        "asset": { "const": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" },
        "display_asset": { "const": "USDC" },
        "asset_decimals": { "const": 6 },
        "amount_atomic": { "enum": ["2000", "20000"] },
        "display_price_usdc": { "enum": ["0.002", "0.02"] },
        "settlement_wallet": { "type": "string", "minLength": 1 },
        "max_timeout_seconds": { "const": 60 },
        "resource_type": { "enum": ["state_ping", "context_delta"] },
        "resource_uri": { "type": "string", "minLength": 1 },
        "pricing_model": { "const": "pay_per_context_resource" },
        "authority_effect": { "const": "none" },
        "access_effect": { "const": "context_resource_access_only" }
      },
      "allOf": [
        {
          "if": { "properties": { "resource_type": { "const": "state_ping" } }, "required": ["resource_type"] },
          "then": {
            "properties": {
              "amount_atomic": { "const": "2000" },
              "display_price_usdc": { "const": "0.002" }
            }
          }
        },
        {
          "if": { "properties": { "resource_type": { "const": "context_delta" } }, "required": ["resource_type"] },
          "then": {
            "properties": {
              "amount_atomic": { "const": "20000" },
              "display_price_usdc": { "const": "0.02" }
            }
          }
        }
      ]
    },
    "payment_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "header_name",
        "payment_required_header",
        "payment_required",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "record_type": { "const": "payment_challenge" },
        "header_name": { "const": "PAYMENT-REQUIRED" },
        "payment_required_header": { "type": "string", "minLength": 1 },
        "payment_required": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x402Version", "resource", "accepts", "extensions"],
          "properties": {
            "x402Version": { "const": 2 },
            "resource": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "description", "mimeType"],
              "properties": {
                "url": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "mimeType": { "const": "application/json" }
              }
            },
            "accepts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/$defs/upstream_requirements" }
            },
            "extensions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nova"],
              "properties": { "nova": { "$ref": "#/$defs/nova_extension" } }
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payment_requirement_id",
            "resource_type",
            "resource_uri",
            "pricing_model",
            "authority_effect",
            "access_effect"
          ],
          "properties": {
            "payment_requirement_id": { "type": "string", "pattern": "^payment-requirement-[0-9a-f]{24}$" },
            "resource_type": { "enum": ["state_ping", "context_delta"] },
            "resource_uri": { "type": "string", "minLength": 1 },
            "pricing_model": { "const": "pay_per_context_resource" },
            "authority_effect": { "const": "none" },
            "access_effect": { "const": "context_resource_access_only" }
          }
        }
      }
    },
    "payment_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "payment_receipt_id",
        "payment_requirement_id",
        "resource_type",
        "resource_uri",
        "pricing_model",
        "payment_verification_status",
        "settlement_status",
        "access_status",
        "payer",
        "network",
        "asset",
        "amount_atomic",
        "settlement_wallet",
        "transaction_reference",
        "failure_reason",
        "authority_effect",
        "access_effect"
      ],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "record_type": { "const": "payment_receipt" },
        "payment_receipt_id": { "type": "string", "pattern": "^payment-receipt(?:-failed)?-[0-9a-f]{24}$" },
        "payment_requirement_id": { "type": "string", "pattern": "^payment-requirement-[0-9a-f]{24}$" },
        "resource_type": { "enum": ["state_ping", "context_delta"] },
        "resource_uri": { "type": "string", "minLength": 1 },
        "pricing_model": { "const": "pay_per_context_resource" },
        "payment_verification_status": { "enum": ["not_attempted", "verified", "failed"] },
        "settlement_status": { "enum": ["not_attempted", "settled", "failed"] },
        "access_status": { "enum": ["denied", "permitted"] },
        "payer": { "type": ["string", "null"] },
        "network": { "const": "eip155:8453" },
        "asset": { "const": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" },
        "amount_atomic": { "enum": ["2000", "20000"] },
        "settlement_wallet": { "type": "string", "minLength": 1 },
        "transaction_reference": { "type": ["string", "null"] },
        "failure_reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "payment_verification_failed",
            "payment_settlement_failed",
            "settlement_reference_missing",
            "settlement_network_mismatch",
            "settlement_amount_mismatch",
            "unsupported_x402_version",
            "settlement_wallet_not_configured",
            "resource_not_payable",
            "invalid_payment_payload"
          ]
        },
        "authority_effect": { "const": "none" },
        "access_effect": { "const": "context_resource_access_only" }
      },
      "allOf": [
        {
          "if": { "properties": { "access_status": { "const": "permitted" } }, "required": ["access_status"] },
          "then": {
            "properties": {
              "payment_verification_status": { "const": "verified" },
              "settlement_status": { "const": "settled" },
              "transaction_reference": { "type": "string", "minLength": 1 },
              "failure_reason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "settlement_status": { "const": "settled" } }, "required": ["settlement_status"] },
          "then": { "properties": { "access_status": { "const": "permitted" } } }
        },
        {
          "if": { "properties": { "payment_verification_status": { "const": "failed" } }, "required": ["payment_verification_status"] },
          "then": {
            "properties": {
              "settlement_status": { "const": "not_attempted" },
              "access_status": { "const": "denied" }
            }
          }
        }
      ]
    }
  }
}
