{
  "name": "review_context_contract",
  "version": "design-v2.1",
  "interface_type": "proposed_response_contract",
  "implementation_status": "not_implemented",
  "canonicality_source": "authoritative_repository_main",
  "incorporated_Gate_3_refinements": [
    "G3-R01",
    "G3-R03",
    "G3-R08",
    "G3-R11",
    "G3-Q15"
  ],
  "runtime_implemented": false,
  "approved_for_runtime_implementation": false,
  "endpoint_exists": false,
  "private_adapter_started": false,
  "Gate_4_authority": false,
  "authority_model": "non_authority",
  "authority_effect": "none",
  "execution_effect": "none",
  "canonical_boundary": [
    "Agent prepares action.",
    "Nova structures review context.",
    "Local authority decides.",
    "External systems execute.",
    "Nova does not execute."
  ],
  "request_model": {
    "record_type": "review_context_request",
    "semantics": {
      "prepared_action_origin": "external_to_Nova",
      "permission_application": false,
      "Nova_selects_institutional_policy": false,
      "sensitive_fields_require_scoped_handling": true
    },
    "required_fields": [
      "request_id",
      "prepared_action",
      "evidence",
      "institution_context",
      "review_profile",
      "requested_context"
    ],
    "prepared_action_fields": [
      "action_type",
      "asset_or_resource",
      "amount_or_scope",
      "destination_or_venue",
      "intended_time_window"
    ],
    "prepared_action_optional_identity_fields": [
      "action_id",
      "proposal_version_id"
    ],
    "prepared_action_identity_semantics": {
      "identities_distinct": true,
      "action_id": {
        "purpose": "stable_identity_across_revisions",
        "authority": "external_institution_or_orchestrator_only",
        "required_when_cross_revision_lineage_is_claimed": true,
        "Nova_content_derivation_permitted": false,
        "missing_behavior": "lineage_unavailable_and_no_same_action_inference",
        "opaque_external_reference": true
      },
      "proposal_version_id": {
        "purpose": "identity_of_exact_proposal_reviewed",
        "preferred_source": "external_institution_or_orchestrator",
        "external_request_field_optional": true,
        "fallback": {
          "source": "Nova_derived_proposal_fingerprint",
          "explicit_label_required": true,
          "material_scope": "canonical_prepared_action_material_only",
          "algorithm_qualified": true,
          "establishes_action_lineage": false
        }
      }
    },
    "evidence_fields": [
      "sources",
      "observed_at",
      "received_at"
    ],
    "institution_context_fields": [
      "institution_id_or_policy_profile",
      "relevant_constraints",
      "prior_review_references"
    ],
    "review_profile": {
      "required_fields": [
        "profile_id",
        "profile_version",
        "profile_owner",
        "required_context_fields",
        "profile_hash"
      ],
      "defines_completeness_requirements": true,
      "selection_authority": "institution_approved_configuration",
      "Nova_invents_institution_requirements": false,
      "profile_change_may_change_completeness_without_evidence_change": true,
      "identity_and_version_preserved_for_proof_and_reproducibility": true
    },
    "requested_context_values": [
      "source_state",
      "contradiction_visibility",
      "constraint_context",
      "chronology_context",
      "temporal_context",
      "review_completeness"
    ],
    "requested_context_mapping": {
      "contradiction_visibility": "review_context_response.contradiction_context"
    }
  },
  "response_model": {
    "record_type": "review_context_response",
    "required_fields": [
      "schema_version",
      "context_id",
      "request_id",
      "created_at",
      "prepared_action_reference",
      "review_profile_reference",
      "record_source_type",
      "context_state",
      "source_state",
      "constraint_context",
      "temporal_context",
      "contradiction_context",
      "review_completeness",
      "chronology_context",
      "authority_handoff",
      "reproducibility",
      "boundary"
    ],
    "prepared_action_reference": {
      "required_fields": [
        "reference_id",
        "proposal_version_identity",
        "reference_type",
        "payload_embedded"
      ],
      "optional_fields": [
        "action_id"
      ],
      "reference_type": "opaque_external_reference",
      "payload_embedded": false,
      "proposal_version_identity": {
        "required_fields": [
          "value",
          "source_type"
        ],
        "source_type_permitted_values": [
          "external_institution_or_orchestrator",
          "Nova_derived_proposal_fingerprint"
        ],
        "conditional_fields": {
          "when_source_type_is_Nova_derived_proposal_fingerprint": {
            "algorithm_qualification": "required",
            "material_scope": "canonical_prepared_action_material_only"
          },
          "when_source_type_is_external_institution_or_orchestrator": {
            "algorithm_qualification": "absent",
            "material_scope": "absent",
            "value_treatment": "preserve_opaque_external_value"
          }
        },
        "establishes_action_lineage": false
      },
      "semantics": {
        "action_origin": "external_to_Nova",
        "Nova_owns_action": false,
        "full_action_payload_required_in_response": false,
        "sensitive_action_data_embedded_by_default": false,
        "reference_grants_execution_authority": false,
        "identity_semantics": {
          "action_and_proposal_identity_distinct": true,
          "action_id": {
            "meaning": "stable_action_lineage_identity_when_externally_supplied",
            "required_when_cross_revision_lineage_is_claimed": true,
            "missing_behavior": "lineage_unavailable_and_no_same_action_inference"
          },
          "proposal_version_identity": {
            "meaning": "identity_of_exact_proposal_reviewed",
            "required": true,
            "source_genesis_machine_visible": true,
            "Nova_fallback_must_be_explicitly_labeled": true,
            "Nova_fallback_material_scope": "canonical_prepared_action_material_only",
            "Nova_fallback_algorithm_qualified": true,
            "establishes_action_lineage": false
          },
          "reference_id": "compatibility_reference_not_a_substitute_for_both_identities"
        }
      },
      "sensitive_fields_prohibited_by_default": [
        "destination_addresses",
        "full_transaction_payloads",
        "policy_sensitive_details",
        "personal_data",
        "institution_secrets"
      ],
      "exception_requires_separately_approved_review_profile": true
    },
    "review_profile_reference": {
      "required_fields": [
        "profile_id",
        "profile_version",
        "profile_owner",
        "profile_hash"
      ]
    },
    "record_source_type": {
      "permitted_values": [
        "synthetic",
        "production_like",
        "live",
        "mixed"
      ],
      "required_fields": [
        "value",
        "source_segmentation"
      ],
      "semantics": {
        "synthetic": "generated_or_constructed_for_testing",
        "production_like": "realistic_but_not_verified_live_institutional_evidence",
        "live": "observed_from_an_authorized_live_source_under_declared_scope",
        "mixed": "more_than_one_evidence_environment_class_is_represented"
      },
      "production_like_may_be_represented_as_live": false,
      "source_segmentation_authoritative_for_component_provenance": true,
      "aggregate_environment_ranking": "prohibited",
      "mixed_reduction_to_strongest_or_weakest": false,
      "live_does_not_mean": [
        "truth",
        "correctness",
        "approval",
        "acceptance",
        "executable"
      ],
      "aggregate_derivation": {
        "homogeneous_packet": "emit_the_single_environment_class",
        "more_than_one_environment_class": "mixed"
      },
      "mixed_source_packet_segmentation_level": "field_or_source_reference",
      "proof_preserves_source_segmentation": true,
      "signature_upgrades_evidence": false
    },
    "context_state": {
      "permitted_values": [
        "current",
        "uncertain",
        "stale",
        "superseded"
      ],
      "required_fields": [
        "value",
        "reasons"
      ]
    },
    "source_state": {
      "permitted_values": [
        "complete",
        "partial",
        "conflicted",
        "unavailable"
      ],
      "required_fields": [
        "value",
        "sources",
        "unresolved_source_conflicts"
      ]
    },
    "constraint_context": {
      "required_fields": [
        "observed_constraints",
        "constraint_sources",
        "unresolved_constraint_questions"
      ]
    },
    "temporal_context": {
      "required_fields": [
        "source_observed_at",
        "source_received_at",
        "review_context_created_at",
        "intended_action_window",
        "temporal_conflicts",
        "pending_state"
      ]
    },
    "contradiction_context": {
      "required_fields": [
        "source_conflicts",
        "constraint_conflicts",
        "temporal_conflicts",
        "chronology_conflicts",
        "unresolved_questions"
      ],
      "descriptive_only": true,
      "Nova_selects_winning_source": false,
      "Nova_resolves_policy_dispute": false,
      "empty_list_meaning": "no_conflict_identified_within_declared_scope",
      "empty_list_proves_no_external_conflict": false
    },
    "review_completeness": {
      "permitted_values": [
        "unavailable",
        "conflicted",
        "partial",
        "complete"
      ],
      "required_fields": [
        "value",
        "missing_context",
        "unresolved_conditions"
      ],
      "semantic_owner": "target_v2_contract",
      "precedence": [
        "unavailable",
        "conflicted",
        "partial",
        "complete"
      ],
      "meanings": {
        "unavailable": "completeness_cannot_be_evaluated_because_the_applicable_profile_or_required_field_inventory_is_unavailable",
        "conflicted": "required_context_contains_unresolved_material_conflict",
        "partial": "required_context_is_missing_or_unavailable_without_a_higher_priority_material_conflict",
        "complete": "all_required_dimensions_are_represented_including_allowed_explicit_unresolved_states_and_no_material_conflict_exists"
      },
      "profile_defines": [
        "required_fields",
        "required_evidence",
        "thresholds_and_maximum_age",
        "source_hierarchy",
        "constraint_applicability",
        "revalidation_conditions"
      ],
      "profile_may_redefine_enum_meaning_or_precedence": false,
      "complete_does_not_mean": [
        "policy_satisfied",
        "safe",
        "permitted",
        "approved",
        "executable"
      ],
      "does_not_mean": [
        "institutional_policy_satisfied",
        "transaction_permitted",
        "risk_accepted",
        "action_executable",
        "legal_approval_obtained",
        "compliance_approval_obtained"
      ]
    },
    "chronology_context": {
      "required_fields": [
        "prior_review_references",
        "accepted_memory_references",
        "relevant_changes_since_prior_review"
      ],
      "automatic_chronology_acceptance": false
    },
    "authority_handoff": {
      "decision_owner": "local_institutional_authority",
      "execution_owner": "external_system",
      "Nova_authority_effect": "none"
    },
    "reproducibility": {
      "required_fields": [
        "schema_version",
        "source_versions",
        "classification_version",
        "review_profile_id",
        "review_profile_version",
        "review_profile_hash",
        "record_source_type",
        "source_segmentation",
        "context_hash",
        "signature"
      ]
    },
    "boundary": {
      "approval_effect": "none",
      "authorization_effect": "none",
      "execution_effect": "none"
    }
  },
  "canonicalization_semantics": {
    "incorporated_refinement": "G3-R11",
    "profile_id": "nova-jcs-exact-financial-json",
    "profile_version": "design-v0.1",
    "structural_baseline": "RFC_8785_JCS",
    "JCS_deviation": false,
    "application_profile_applied_before_JCS_serialization": true,
    "production_hash_algorithm_selected": false,
    "unicode": {
      "preserve_code_points_as_supplied": true,
      "silent_normalization": false,
      "invalid_Unicode_or_lone_surrogates": "reject",
      "object_key_order": "RFC_8785_UTF16_code_unit_lexicographic",
      "enum_alias_or_case_coercion": "prohibited"
    },
    "null_and_absence": {
      "distinct": true,
      "missing_to_null_coercion": "prohibited",
      "required_absence": "projection_failure_or_explicit_unresolved_state_under_declared_field_rule"
    },
    "numeric": {
      "binary_floating_point_financial_values": "prohibited",
      "NaN_and_infinity": "prohibited",
      "rounding_or_truncation": "prohibited",
      "exact_integer": {
        "representation": {
          "numeric_type": "integer",
          "value": "canonical_base10_string"
        },
        "exponent": "prohibited",
        "leading_zeros": "prohibited_except_zero",
        "plus_sign": "prohibited",
        "decimal_point": "prohibited",
        "negative_zero": "normalize_to_zero",
        "precision": "field_profile_max_digits"
      },
      "exact_decimal": {
        "representation": {
          "numeric_type": "decimal",
          "coefficient": "signed_base10_string",
          "scale": "nonnegative_integer"
        },
        "value_definition": "coefficient_times_10_to_negative_scale",
        "exponent_input": "normalization_boundary_only_and_eliminated_from_canonical_material",
        "negative_zero": "coefficient_zero_without_sign",
        "generic_trailing_zeros": "trim_before_canonical_resulting_scale_validation",
        "fixed_scale_trailing_zeros": "preserve_profile_declared_scale",
        "required_limits": [
          "max_precision",
          "max_scale",
          "max_abs_exponent",
          "max_input_characters"
        ],
        "max_abs_exponent_check": "before_coefficient_expansion",
        "max_input_characters_check": "before_numeric_parsing",
        "rounding": "prohibited"
      },
      "monetary_amount": {
        "representation": {
          "numeric_type": "monetary_amount",
          "asset_id": "explicit_opaque_asset_or_unit",
          "coefficient": "signed_base10_string",
          "scale": "profile_declared_nonnegative_integer"
        },
        "asset_or_unit_inference": "prohibited",
        "scale_inference": "prohibited",
        "missing_asset_or_scale": "unresolved_not_canonicalizable",
        "required_limits": [
          "max_precision",
          "max_scale",
          "max_abs_exponent",
          "max_input_characters"
        ],
        "rounding": "prohibited",
        "authority_effect": "none",
        "execution_effect": "none"
      }
    },
    "timestamp": {
      "input": "RFC_3339_with_explicit_offset",
      "output_timezone": "UTC_Z",
      "fractional_second_digits": 6,
      "whole_seconds": "append_.000000",
      "shorter_fraction": "right_pad_to_six_digits",
      "sub_microsecond": "reject_without_rounding",
      "unknown_offset_minus_00_00": "reject_not_UTC_equivalent",
      "invalid_calendar_or_leap_second": "reject",
      "intended_action_window": {
        "boundary_fields": [
          "start",
          "end"
        ],
        "normalization": "same_RFC3339_UTC_fixed_precision_rules",
        "invalid_or_missing": "projection_failure_or_explicit_unresolved_state_under_declared_field_rule",
        "silent_normalization": false
      },
      "normalization_creates_trusted_time": false
    },
    "semantic_arrays": {
      "classification_required": true,
      "permitted_classifications": [
        "ordered_sequence",
        "set",
        "multiset"
      ],
      "undeclared_array_behavior": "projection_failure",
      "set_semantics": {
        "deterministic_normalization": true,
        "deterministic_sort_key": "declared_field_or_type_specific_primary_tuple_then_declared_final_tie_breaker",
        "JCS_role": "serialize_after_declared_tuple_normalization_and_normalized_item_bytes_only_as_declared_final_tie_breaker",
        "byte_identical_duplicate": "collapse_only_for_declared_set",
        "same_identity_different_content": "conflict",
        "primary_tuple_tie": "normalized_item_JCS_bytes_only_when_profile_declares_final_tie_breaker"
      },
      "sort_tuple_profiles": {
        "source_reference_sort": {
          "primary": [
            "source_id",
            "source_version_or_digest",
            "observed_at",
            "received_at",
            "record_source_type"
          ],
          "final_tie_breaker": "normalized_item_JCS_bytes"
        },
        "constraint_reference_sort": {
          "primary": [
            "constraint_id_or_digest",
            "source_id"
          ],
          "final_tie_breaker": "normalized_item_JCS_bytes"
        },
        "chronology_reference_sort": {
          "primary": [
            "reference_type",
            "reference_id",
            "version_or_digest"
          ],
          "final_tie_breaker": "normalized_item_JCS_bytes"
        },
        "digest_record_sort": [
          "algorithm",
          "parameter_set",
          "output_encoding",
          "digest"
        ],
        "conflict_reference_sort": [
          "conflict_id"
        ],
        "question_reference_sort": [
          "question_id"
        ],
        "condition_reference_sort": [
          "condition_id"
        ],
        "change_reference_sort": [
          "change_id"
        ],
        "stable_scalar_sort": [
          "$value"
        ]
      },
      "array_rules": {
        "review_context_response.record_source_type.source_segmentation": {"classification": "set", "sort_tuple_profile": "source_reference_sort"},
        "review_context_response.context_state.reasons": {"classification": "set", "sort_tuple_profile": "stable_scalar_sort"},
        "review_context_response.source_state.sources": {"classification": "set", "sort_tuple_profile": "source_reference_sort"},
        "review_context_response.source_state.unresolved_source_conflicts": {"classification": "set", "sort_tuple_profile": "conflict_reference_sort"},
        "review_context_response.constraint_context.observed_constraints": {"classification": "set", "sort_tuple_profile": "constraint_reference_sort"},
        "review_context_response.constraint_context.constraint_sources": {"classification": "set", "sort_tuple_profile": "source_reference_sort"},
        "review_context_response.constraint_context.unresolved_constraint_questions": {"classification": "set", "sort_tuple_profile": "question_reference_sort"},
        "review_context_response.temporal_context.temporal_conflicts": {"classification": "set", "sort_tuple_profile": "conflict_reference_sort"},
        "review_context_response.temporal_context.pending_state": {"classification": "set", "sort_tuple_profile": "condition_reference_sort"},
        "review_context_response.contradiction_context.source_conflicts": {"classification": "set", "sort_tuple_profile": "conflict_reference_sort"},
        "review_context_response.contradiction_context.constraint_conflicts": {"classification": "set", "sort_tuple_profile": "conflict_reference_sort"},
        "review_context_response.contradiction_context.temporal_conflicts": {"classification": "set", "sort_tuple_profile": "conflict_reference_sort"},
        "review_context_response.contradiction_context.chronology_conflicts": {"classification": "set", "sort_tuple_profile": "conflict_reference_sort"},
        "review_context_response.contradiction_context.unresolved_questions": {"classification": "set", "sort_tuple_profile": "question_reference_sort"},
        "review_context_response.review_completeness.missing_context": {"classification": "set", "sort_tuple_profile": "stable_scalar_sort"},
        "review_context_response.review_completeness.unresolved_conditions": {"classification": "set", "sort_tuple_profile": "condition_reference_sort"},
        "review_context_response.chronology_context.prior_review_references": {"classification": "set", "sort_tuple_profile": "chronology_reference_sort"},
        "review_context_response.chronology_context.accepted_memory_references": {"classification": "set", "sort_tuple_profile": "chronology_reference_sort"},
        "review_context_response.chronology_context.relevant_changes_since_prior_review": {"classification": "set", "sort_tuple_profile": "change_reference_sort"},
        "review_context_response.reproducibility.source_versions": {"classification": "set", "sort_tuple_profile": "stable_scalar_sort"},
        "review_context_response.reproducibility.source_segmentation": {"classification": "set", "sort_tuple_profile": "source_reference_sort"}
      }
    }
  },
  "semantic_identity_continuity": {
    "incorporated_refinement": "G3-Q15",
    "semantic_identity_is_individual_digest": false,
    "semantic_identity_basis": "identical_canonical_semantic_byte_sequence_under_the_governing_contract_and_canonicalization_context",
    "algorithm_qualified_digest_role": "evidence_about_canonical_semantic_bytes",
    "historical_digest_evidence_preserved": true,
    "successor_or_parallel_digest_overwrites_history": false,
    "successor_or_parallel_digest_binding": "identical_canonical_semantic_bytes_or_verifiable_preserved_reference",
    "same_hash_value_claim_across_algorithms": "prohibited",
    "unverifiable_semantic_bytes_behavior": "continuity_unresolved",
    "transport_shape": {
      "current_compatibility_context_hash": "singular",
      "plural_digest_response_shape_incorporated": false,
      "G3_Q13_status": "not_incorporated"
    },
    "production_hash_algorithm_selected": false
  },
  "prohibited_external_fields": [
    "decision_status",
    "decision_admission_record",
    "permission_budget",
    "permission_budget_class",
    "adjusted_size",
    "conditioned_size",
    "execution_posture",
    "halt_release_authority",
    "prevented_action",
    "intervention_type",
    "recommended_action"
  ],
  "prohibited_external_values": [
    "ALLOW",
    "CONSTRAIN",
    "VETO",
    "DENY",
    "HALT",
    "REDUCE",
    "RETRY_BLOCKED",
    "RETRY_DELAYED",
    "PRESSURE_ESCALATED",
    "approved",
    "authorized",
    "executable",
    "cleared",
    "blocked"
  ],
  "authority_semantics": {
    "permitted": [
      "authoritative_source_identity",
      "authoritative_schema_version",
      "authoritative_record_hash",
      "authoritative_Nova_observation"
    ],
    "prohibited": [
      "authoritative_execution_permission",
      "authoritative_transaction_decision",
      "authoritative_institutional_approval",
      "authoritative_denial"
    ],
    "interpretation": "Nova may authoritatively record its observation and packet construction but does not make the institutional decision."
  },
  "proof_semantics": {
    "proof_type": "review_context_integrity",
    "authority_effect": "none",
    "verifies": [
      "packet_integrity",
      "schema_identity",
      "source_reference_integrity",
      "classification_version",
      "context_hash",
      "creation_time",
      "chronology_references",
      "reproducibility_inputs",
      "review_profile_identity",
      "review_profile_hash",
      "record_source_type",
      "source_segmentation"
    ],
    "does_not_verify": [
      "approval",
      "authorization",
      "execution_permission",
      "institutional_acceptance",
      "transaction_validity"
    ]
  },
  "http_semantics": {
    "valid_context_response": 200,
    "incomplete_context": 200,
    "conflicted_context": 200,
    "stale_context": 200,
    "unavailable_source_context": {
      "status": 200,
      "condition": "request_processed_and_unavailability_can_be_described"
    },
    "malformed_request": [
      400,
      422
    ],
    "authentication_failure": [
      401,
      403
    ],
    "rate_limit": 429,
    "Nova_service_unavailable": 503,
    "domain_state_changes_HTTP_status": false,
    "interpretation": "HTTP status describes request handling and never the institution's action decision."
  },
  "internal_classification_boundary": {
    "may_exist": true,
    "may_be_exposed_as_external_permission": false,
    "may_directly_determine_local_execution": false,
    "may_be_used_to_construct_descriptive_context": "only_with_field_level_mapping_review",
    "public_packet_may_be_derived_solely_from_legacy_status": false,
    "required_derivation_sources": [
      "source_condition",
      "telemetry_integrity",
