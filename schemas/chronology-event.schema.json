{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpenova.internal/schemas/chronology-event.schema.json",
  "title": "Sharpe Nova OS Chronology Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "chronology_lane", "occurred_at", "recorded_at", "actor", "authority_status", "review_status", "acceptance_status", "confidence", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^(RFX|ARC|OPS|GOV)-[0-9]{8}-[A-Z0-9][A-Z0-9_-]{2,80}$"},
    "event_type": {"type": "string", "minLength": 3},
    "chronology_lane": {"enum": ["reflex", "archive", "operations", "governance"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": ["string", "null"], "format": "date-time"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["type", "identifier"], "properties": {"type": {"enum": ["Architect", "Jarvis-Nova_CCO", "operator", "repository", "CI", "system", "unknown"]}, "identifier": {"type": "string", "minLength": 1}}},
    "repository": {"type": ["string", "null"]},
    "branch": {"type": ["string", "null"]},
    "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
    "artifact_refs": {"type": "array", "items": {"$ref": "#/$defs/reference"}, "default": []},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "prior_state": {"type": ["object", "null"]},
    "resulting_state": {"type": ["object", "null"]},
    "authority_status": {"enum": ["informational", "proposed", "reviewed", "authorized", "implemented", "executed", "accepted", "superseded", "rejected", "blocked", "not_applicable"]},
    "review_status": {"enum": ["not_required", "pending", "reviewed", "rejected"]},
    "acceptance_status": {"enum": ["not_applicable", "pending", "accepted", "rejected", "blocked"]},
    "confidence": {"enum": ["verified", "strongly_supported", "partially_supported", "inferred", "unresolved"]},
    "supersedes": {"type": "array", "items": {"type": "string"}, "default": []},
    "superseded_by": {"type": "array", "items": {"type": "string"}, "default": []},
    "corrects_event_id": {"type": ["string", "null"]},
    "correction_reason": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {"reference": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"enum": ["file", "commit", "pull_request", "CI_run", "report", "archive", "conversation_record", "governance_record", "external_reference"]}, "value": {"type": "string", "minLength": 1}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}}
}
