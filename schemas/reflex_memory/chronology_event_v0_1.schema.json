{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpenovaos.local/schemas/reflex_memory/chronology_event_v0_1.schema.json",
  "title": "Chronology Event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chronology_event_id",
    "event_type",
    "status",
    "accepted_for_reflex_candidate",
    "created_at",
    "source_state",
    "summary",
    "boundary_risk",
    "evidence_refs",
    "non_authority_statement"
  ],
  "properties": {
    "chronology_event_id": {
      "type": "string",
      "pattern": "^CHR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "source_state_review",
        "boundary_language_review",
        "proof_reference_review"
      ]
    },
    "status": {
      "const": "reviewed"
    },
    "accepted_for_reflex_candidate": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "limitations"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "source_confirmed",
            "source_incomplete",
            "source_conflict",
            "cco_reconciled"
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "boundary_risk": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_authority_statement": {
      "type": "string",
      "pattern": "does not approve"
    }
  }
}
