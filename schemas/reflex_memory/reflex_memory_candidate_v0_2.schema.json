{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpenovaos.local/schemas/reflex_memory/reflex_memory_candidate_v0_2.schema.json",
  "title": "Reflex Memory Candidate v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "version",
    "lifecycle_status",
    "knowledge_class",
    "proposed_lesson",
    "proposed_review_posture_effect",
    "source_chronology_event_ids",
    "supporting_evidence_refs",
    "action_class",
    "applicability_conditions",
    "material_distinctions",
    "known_exceptions",
    "contradictory_cases",
    "unresolved_conditions",
    "epistemic_status",
    "authority_treatment",
    "precedent_treatment",
    "proposed_by",
    "proposed_at",
    "reviewed_by",
    "reviewed_at",
    "accepted_by",
    "accepted_at",
    "valid_from",
    "review_after",
    "supersedes",
    "superseded_by",
    "converted_entry_id",
    "authority_effect",
    "non_authority_statement"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^RMC-[0-9]{4}$"},
    "version": {"const": "reflex_memory_candidate_v0_2"},
    "lifecycle_status": {
      "type": "string",
      "enum": ["candidate", "reviewed", "accepted", "rejected", "archived"]
    },
    "knowledge_class": {
      "type": "string",
      "enum": ["propositional", "prescriptive", "constraint_pattern", "source_pattern", "exception", "counterexample", "boundary_risk"]
    },
    "proposed_lesson": {"type": "string", "minLength": 1},
    "proposed_review_posture_effect": {
      "type": "string",
      "enum": [
        "surface_prior_stress",
        "require_source_reconciliation_context",
        "flag_boundary_language_risk",
        "mark_context_as_source_limited",
        "preserve_manual_review_attention",
        "add_chronology_reference",
        "require_proof_reference",
        "highlight_recurring_context_pattern"
      ]
    },
    "source_chronology_event_ids": {"$ref": "#/$defs/non_empty_chronology_ids"},
    "supporting_evidence_refs": {"$ref": "#/$defs/non_empty_strings"},
    "action_class": {"type": "string", "minLength": 1},
    "applicability_conditions": {"$ref": "#/$defs/non_empty_strings"},
    "material_distinctions": {"$ref": "#/$defs/strings"},
    "known_exceptions": {"$ref": "#/$defs/strings"},
    "contradictory_cases": {"$ref": "#/$defs/strings"},
    "unresolved_conditions": {"$ref": "#/$defs/strings"},
    "epistemic_status": {
      "type": "string",
      "enum": ["source_supported", "source_limited", "disputed", "contradicted", "unverified", "superseded"]
    },
    "authority_treatment": {
      "type": "string",
      "enum": ["reference_only", "accepted_for_review_use", "exception_only", "formally_adopted_by_local_authority", "superseded"]
    },
    "precedent_treatment": {
      "type": "string",
      "enum": ["none", "analogous", "materially_distinguishable", "exception_only", "contradicted", "superseded"]
    },
    "proposed_by": {"type": "string", "minLength": 1},
    "proposed_at": {"type": "string", "format": "date-time"},
    "reviewed_by": {"type": ["string", "null"], "minLength": 1},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "accepted_by": {"type": ["string", "null"], "minLength": 1},
    "accepted_at": {"type": ["string", "null"], "format": "date-time"},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "review_after": {"type": ["string", "null"], "format": "date"},
    "supersedes": {"$ref": "#/$defs/strings"},
    "superseded_by": {"type": ["string", "null"], "minLength": 1},
    "converted_entry_id": {"type": ["string", "null"], "pattern": "^RM-[0-9]{4}$"},
    "authority_effect": {"const": "none"},
    "non_authority_statement": {"type": "string", "pattern": "does not (approve|create authority)"}
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle_status": {"const": "reviewed"}}, "required": ["lifecycle_status"]},
      "then": {
        "properties": {
          "reviewed_by": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"properties": {"lifecycle_status": {"const": "accepted"}}, "required": ["lifecycle_status"]},
      "then": {
        "properties": {
          "reviewed_by": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "accepted_by": {"type": "string", "minLength": 1},
          "accepted_at": {"type": "string", "format": "date-time"},
          "converted_entry_id": {"type": "string", "pattern": "^RM-[0-9]{4}$"}
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"authority_treatment": {"const": "exception_only"}}, "required": ["authority_treatment"]},
          {"properties": {"precedent_treatment": {"const": "exception_only"}}, "required": ["precedent_treatment"]}
        ]
      },
      "then": {"properties": {"known_exceptions": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"epistemic_status": {"enum": ["disputed", "contradicted"]}}, "required": ["epistemic_status"]},
      "then": {"properties": {"contradictory_cases": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"authority_treatment": {"const": "formally_adopted_by_local_authority"}}, "required": ["authority_treatment"]},
      "then": {
        "properties": {
          "accepted_by": {"type": "string", "minLength": 1},
          "accepted_at": {"type": "string", "format": "date-time"},
          "supporting_evidence_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"epistemic_status": {"const": "superseded"}}, "required": ["epistemic_status"]},
          {"properties": {"authority_treatment": {"const": "superseded"}}, "required": ["authority_treatment"]},
          {"properties": {"precedent_treatment": {"const": "superseded"}}, "required": ["precedent_treatment"]}
        ]
      },
      "then": {"properties": {"superseded_by": {"type": "string", "minLength": 1}}}
    }
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "non_empty_chronology_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CHR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"}
    }
  }
}
