{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpenovaos.local/schemas/reflex_memory/reflex_memory_entry_v0_1.schema.json",
  "title": "Reflex Memory Entry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reflex_id",
    "version",
    "status",
    "source_chronology_event_ids",
    "created_at",
    "reviewed_at",
    "accepted_at",
    "accepted_by",
    "source_state",
    "trigger_pattern",
    "stress_type",
    "boundary_risk",
    "review_posture_effect",
    "evidence_refs",
    "expiration_or_review_after",
    "authority_effect",
    "non_authority_statement"
  ],
  "properties": {
    "reflex_id": {
      "type": "string",
      "pattern": "^RM-[0-9]{4}$"
    },
    "version": {
      "const": "reflex_memory_v0_1"
    },
    "status": {
      "const": "accepted"
    },
    "source_chronology_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^CHR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_by": {
      "type": "string",
      "minLength": 1
    },
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "limitations"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "source_confirmed",
            "source_incomplete",
            "cco_reconciled"
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trigger_pattern": {
      "type": "string",
      "enum": [
        "source_state_conflict",
        "boundary_language_drift",
        "proof_reference_missing"
      ]
    },
    "stress_type": {
      "type": "string",
      "enum": [
        "source_integrity_risk",
        "authority_boundary_risk",
        "proof_lineage_incomplete"
      ]
    },
    "boundary_risk": {
      "type": "string",
      "minLength": 1
    },
    "review_posture_effect": {
      "type": "string",
      "enum": [
        "require_source_reconciliation_context",
        "flag_boundary_language_risk",
        "require_proof_reference"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expiration_or_review_after": {
      "type": "string",
      "format": "date"
    },
    "authority_effect": {
      "const": "none"
    },
    "non_authority_statement": {
      "type": "string",
      "pattern": "does not approve"
    }
  }
}
