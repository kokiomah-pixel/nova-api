{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpenovaos.local/schemas/reflex_memory/reflex_memory_retrieval_explanation_v0_1.schema.json",
  "title": "Reflex Memory Retrieval Explanation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "retrieval_id", "reflex_id", "current_action_id",
    "current_proposal_version_id", "surfaced_because", "comparison_dimensions",
    "comparison_limits", "material_distinctions", "source_chronology_event_ids",
    "epistemic_status", "authority_treatment", "precedent_treatment",
    "precedent_effect", "authority_effect", "non_authority_statement"
  ],
  "properties": {
    "version": {"const": "reflex_memory_retrieval_explanation_v0_1"},
    "retrieval_id": {"type": "string", "pattern": "^RMR-[0-9]{4}$"},
    "reflex_id": {"type": "string", "pattern": "^RM-[0-9]{4}$"},
    "current_action_id": {"type": "string", "minLength": 1},
    "current_proposal_version_id": {"type": "string", "minLength": 1},
    "surfaced_because": {"$ref": "#/$defs/non_empty_strings"},
    "comparison_dimensions": {"$ref": "#/$defs/non_empty_strings"},
    "comparison_limits": {"$ref": "#/$defs/non_empty_strings"},
    "material_distinctions": {"$ref": "#/$defs/strings"},
    "source_chronology_event_ids": {"$ref": "#/$defs/non_empty_chronology_ids"},
    "epistemic_status": {"type": "string", "enum": ["source_supported", "source_limited", "disputed", "contradicted", "unverified", "superseded"]},
    "authority_treatment": {"type": "string", "enum": ["reference_only", "accepted_for_review_use", "exception_only", "formally_adopted_by_local_authority", "superseded"]},
    "precedent_treatment": {"type": "string", "enum": ["none", "analogous", "materially_distinguishable", "exception_only", "contradicted", "superseded"]},
    "precedent_effect": {"const": "none"},
    "authority_effect": {"const": "none"},
    "non_authority_statement": {"type": "string", "pattern": "does not (approve|create authority)"}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "non_empty_strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "non_empty_chronology_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CHR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"}}
  }
}
