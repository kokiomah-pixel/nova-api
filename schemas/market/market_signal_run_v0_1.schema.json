{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpe-nova-os.local/schemas/market/market_signal_run_v0_1.schema.json",
  "title": "Market Signal Run v0.1",
  "type": "object",
  "required": ["market_signal_report"],
  "additionalProperties": false,
  "properties": {
    "market_signal_report": {
      "type": "object",
      "required": [
        "report_id",
        "contract_version",
        "run_mode",
        "coverage_record_origin",
        "original_output_watch_coverage_explicit",
        "observed_date",
        "reporting_window",
        "evidence_coverage",
        "governed_watch_coverage",
        "broad_discovery",
        "reconciliation",
        "aggregate_state",
        "not_established",
        "source_provenance",
        "governance"
      ],
      "additionalProperties": false,
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "contract_version": {"const": "market_signal_run_v0_1"},
        "run_mode": {
          "enum": ["direct_market_signal_run", "retrospective_reconciliation"]
        },
        "coverage_record_origin": {
          "enum": ["contemporaneous_scan", "post_run_governance_reconciliation"]
        },
        "original_output_watch_coverage_explicit": {"type": "boolean"},
        "observed_date": {"type": "string"},
        "reporting_window": {
          "type": "object",
          "required": ["start", "end", "source_scope", "source_limits"],
          "additionalProperties": false,
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"},
            "source_scope": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "source_limits": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_coverage": {
          "enum": ["sufficient", "source_incomplete", "invalid"]
        },
        "governed_watch_coverage": {
          "type": "array",
          "items": {"$ref": "#/$defs/governedWatchCoverage"}
        },
        "broad_discovery": {
          "type": "object",
          "required": [
            "completed_within_stated_scope",
            "observations_reviewed",
            "new_signals"
          ],
          "additionalProperties": false,
          "properties": {
            "completed_within_stated_scope": {"type": "boolean"},
            "observations_reviewed": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "new_signals": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "reconciliation": {
          "type": "object",
          "required": ["related_to_existing_watch", "genuinely_distinct_candidates"],
          "additionalProperties": false,
          "properties": {
            "related_to_existing_watch": {
              "type": "array",
              "items": {"$ref": "#/$defs/relatedObservation"}
            },
            "genuinely_distinct_candidates": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "aggregate_state": {
          "type": "object",
          "required": [
            "environmental_pressure",
            "category_compression",
            "Nova_problem_legibility",
            "direct_Nova_buyer_evidence",
            "buyer_pull",
            "adoption",
            "workflow_dependency"
          ],
          "additionalProperties": false,
          "properties": {
            "environmental_pressure": {"type": "string", "minLength": 1},
            "category_compression": {"type": "string", "minLength": 1},
            "Nova_problem_legibility": {"type": "string", "minLength": 1},
            "direct_Nova_buyer_evidence": {"type": "string", "minLength": 1},
            "buyer_pull": {"type": "string", "minLength": 1},
            "adoption": {"type": "string", "minLength": 1},
            "workflow_dependency": {"type": "string", "minLength": 1}
          }
        },
        "not_established": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_provenance": {"$ref": "#/$defs/provenance"},
        "governance": {"$ref": "#/$defs/governanceNonEffects"}
      }
    }
  },
  "$defs": {
    "governedWatchCoverage": {
      "type": "object",
      "required": [
        "signal_id",
        "required_this_run",
        "scan_attempted",
        "scan_status",
        "delta_state",
        "source_access",
        "escalation_review",
        "authority_effect"
      ],
      "additionalProperties": false,
      "properties": {
        "signal_id": {"type": "string", "minLength": 1},
        "required_this_run": {"type": "boolean"},
        "scan_attempted": {"type": "boolean"},
        "scan_status": {"enum": ["completed", "source_incomplete"]},
        "delta_state": {
          "enum": [
            "no_material_delta",
            "material_delta_observed",
            "source_incomplete",
            "source_unavailable"
          ]
        },
        "source_access": {
          "type": "object",
          "required": ["material_sources_available", "unavailable_sources"],
          "additionalProperties": false,
          "properties": {
            "material_sources_available": {"type": "boolean"},
            "unavailable_sources": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "escalation_review": {
          "type": "object",
          "required": [
            "thesis_strengthening_triggers_checked",
            "category_compression_triggers_checked",
            "stored_escalation_review",
            "escalation_condition_met"
          ],
          "additionalProperties": false,
          "properties": {
            "thesis_strengthening_triggers_checked": {"type": "boolean"},
            "category_compression_triggers_checked": {"type": "boolean"},
            "stored_escalation_review": {
              "type": "object",
              "required": [
                "repeated_institutional_behavior_observed",
                "structural_category_movement_observed",
                "material_competitive_compression_observed",
                "evidence_insufficient_for_trigger"
              ],
              "additionalProperties": false,
              "properties": {
                "repeated_institutional_behavior_observed": {"type": "boolean"},
                "structural_category_movement_observed": {"type": "boolean"},
                "material_competitive_compression_observed": {"type": "boolean"},
                "evidence_insufficient_for_trigger": {"type": "boolean"}
              }
            },
            "escalation_condition_met": {"type": "boolean"}
          }
        },
        "authority_effect": {"const": "none"}
      }
    },
    "relatedObservation": {
      "type": "object",
      "required": [
        "observation_id",
        "watch_signal_id",
        "relationship",
        "provenance",
        "canonical_watch_record_mutated"
      ],
      "additionalProperties": false,
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "watch_signal_id": {"type": "string", "minLength": 1},
        "relationship": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "canonical_watch_record_mutated": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "status", "independent_repository_verification"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "independent_repository_verification": {"type": "boolean"}
      }
    },
    "governanceNonEffects": {
      "type": "object",
      "required": [
        "accepted_state_change",
        "chronology_event_required",
        "chronology_change",
        "Reflex_Memory_effect",
        "Reflex_Memory_change",
        "constraint_change",
        "policy_change",
        "roadmap_authority",
        "roadmap_change",
        "architecture_change",
        "architecture_authority_created",
        "engineering_authority",
        "engineering_authority_created",
        "runtime_change",
        "production_change",
        "external_integration",
        "buyer_demand_established"
      ],
      "additionalProperties": false,
      "properties": {
        "accepted_state_change": {"const": false},
        "chronology_event_required": {"const": false},
        "chronology_change": {"const": false},
        "Reflex_Memory_effect": {"const": "none"},
        "Reflex_Memory_change": {"const": false},
        "constraint_change": {"const": false},
        "policy_change": {"const": false},
        "roadmap_authority": {"const": false},
        "roadmap_change": {"const": false},
        "architecture_change": {"const": false},
        "architecture_authority_created": {"const": false},
        "engineering_authority": {"const": false},
        "engineering_authority_created": {"const": false},
        "runtime_change": {"const": false},
        "production_change": {"const": false},
        "external_integration": {"const": false},
        "buyer_demand_established": {"const": false}
      }
    }
  }
}
