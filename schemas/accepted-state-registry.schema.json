{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpe-nova-os.local/schemas/accepted-state-registry.schema.json",
  "title": "Sharpe Nova OS Accepted-State Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "canonical_path",
    "registry_status",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "const": "sharpe_nova_os_accepted_state_registry"
    },
    "canonical_path": {
      "const": "agent_files/state/accepted-state-registry.yaml"
    },
    "registry_status": {
      "enum": [
        "active"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/accepted_state_entry"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "accepted_state_entry": {
      "type": "object",
      "required": [
        "accepted_state_id",
        "accepted_date",
        "classification",
        "source",
        "accepted_claims",
        "excluded_claims",
        "unresolved_dependencies",
        "supersedes",
        "contradiction_state",
        "stage_state",
        "review_authority"
      ],
      "additionalProperties": false,
      "properties": {
        "accepted_state_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "accepted_date": {
          "type": "string",
          "format": "date"
        },
        "classification": {
          "type": "object",
          "required": [
            "state_type",
            "status",
            "scope",
            "authority_effect",
            "execution_effect"
          ],
          "additionalProperties": false,
          "properties": {
            "state_type": {
              "enum": [
                "governance_infrastructure"
              ]
            },
            "status": {
              "enum": [
                "accepted"
              ]
            },
            "scope": {
              "enum": [
                "bounded_stage_a"
              ]
            },
            "authority_effect": {
              "const": "none"
            },
            "execution_effect": {
              "const": "none"
            }
          }
        },
        "source": {
          "type": "object",
          "required": [
            "repository",
            "pull_requests",
            "merge_commits"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "const": "kokiomah-pixel/sharpe-nova-os"
            },
            "pull_requests": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "allOf": [
                {
                  "contains": {
                    "const": 4
                  }
                },
                {
                  "contains": {
                    "const": 5
                  }
                }
              ]
            },
            "merge_commits": {
              "type": "object",
              "required": [
                "architect_data_operations_visibility",
                "runtime_evidence_policy"
              ],
              "additionalProperties": false,
              "properties": {
                "architect_data_operations_visibility": {
                  "$ref": "#/$defs/sha"
                },
                "runtime_evidence_policy": {
                  "$ref": "#/$defs/sha"
                }
              }
            }
          }
        },
        "accepted_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "excluded_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "Stage_B_activation"
          }
        },
        "unresolved_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradiction_state": {
          "const": "none"
        },
        "stage_state": {
          "type": "object",
          "required": [
            "Stage_A",
            "Stage_B",
            "production_health_claim"
          ],
          "additionalProperties": false,
          "properties": {
            "Stage_A": {
              "type": "object",
              "required": [
                "policy_path",
                "no_evidence_path",
                "eligible_record_ingestion_path",
                "source_immutability",
                "identifier_redaction",
                "live_operation"
              ],
              "additionalProperties": {
                "type": "string"
              },
              "properties": {
                "live_operation": {
                  "const": "not_established"
                }
              }
            },
            "Stage_B": {
              "type": "object",
              "required": [
                "status",
                "activation_requires"
              ],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "const": "locked"
                },
                "activation_requires": {
                  "type": "array",
                  "contains": {
                    "const": "separate_Architect_approval"
                  }
                }
              }
            },
            "production_health_claim": {
              "type": "object",
              "required": [
                "allowed"
              ],
              "additionalProperties": false,
              "properties": {
                "allowed": {
                  "const": false
                }
              }
            }
          }
        },
        "review_authority": {
          "type": "object",
          "required": [
            "Architect_reviewed",
            "CCO_reviewed"
          ],
          "additionalProperties": false,
          "properties": {
            "Architect_reviewed": {
              "type": "boolean"
            },
            "CCO_reviewed": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
